# Copy to .env (or let `node scripts/bootstrap.mjs` write it). Never commit .env.
NEAR_NETWORK=testnet
REGISTRY_ACCOUNT=endorse-v1.testnet
USDC_ACCOUNT=endorse-usdc.testnet
PERSONA_STUDIO=endorse-studio.testnet
PERSONA_ACME=endorse-acme.testnet
PERSONA_FUND=endorse-fund.testnet
PORT=8787
DATA_DIR=data

# Optional
# NEAR_RPC=https://test.rpc.fastnear.com
# ALLOWED_ORIGIN=https://your-web-origin   # restricts CORS; default is permissive for local dev
# ONECLICK_JWT=                             # NEAR Intents partner JWT (removes the 0.2% fee on real swaps)
# EXPLORER_BASE=https://testnet.nearblocks.io

# Production: keys come from the environment instead of ~/.near-credentials
# NEAR_KEYS={"endorse-studio.testnet":"ed25519:...","endorse-acme.testnet":"ed25519:...","endorse-fund.testnet":"ed25519:...","endorse-usdc.testnet":"ed25519:..."}

# Optional: make the Acme persona a real Sputnik DAO (it then confirms and pays by proposal).
# ACME_DAO=thatinvoice-acme.sputnikv2.testnet
# ACME_PROPOSER=endorse-acme.testnet
# ACME_COUNCIL=council.endorse-fund.testnet
